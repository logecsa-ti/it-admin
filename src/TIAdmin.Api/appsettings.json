{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "Name": "TI Admin",
    "Version": "1.0.0",
    "TimeZone": "America/Managua",
    "DefaultPageSize": 25,
    "MaxPageSize": 200
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "GeneralPermitLimit": 300,
    "GeneralWindowSeconds": 60,
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1
  },
  "Storage": {
    "Provider": "local",
    "RootPath": "./storage",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".txt", ".zip" ]
  },
  "Email": {
    "Enabled": false,
    "From": "no-reply@tiadmin.local",
    "FromName": "TI Admin",
    "SmtpHost": "localhost",
    "SmtpPort": 25,
    "UseSsl": false
  },
  "Cache": {
    "Provider": "memory",
    "DefaultExpirationMinutes": 30
  },
  "DataProtection": {
    "KeysPath": "",
    "CertificateThumbprint": ""
  },
  "Seed": {
    "Enabled": false,
    "AdminUserName": "admin",
    "AdminEmail": "admin@tiadmin.local"
  },
  "AllowedHosts": "*"
}
