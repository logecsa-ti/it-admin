{
  "name": "ti-admin-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:snapshot": "node scripts/fetch-openapi.mjs",
    "api:types": "npx -y openapi-typescript@7.13.0 openapi/tiadmin-api.json -o src/app/core/models/api.generated.ts --root-types --root-types-no-schema-prefix",
    "lint:types": "tsc -p tsconfig.app.json --noEmit",
    "api:permissions": "node scripts/sync-permissions.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "material-symbols": "^0.40.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
