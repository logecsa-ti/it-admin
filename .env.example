# ============================================================
# Variables de entorno para desarrollo local TI Admin
# Copiar a .env y ajustar valores. NUNCA commitear .env real.
# ============================================================

# --- SQL Server ---
MSSQL_SA_PASSWORD=LocalDev!Pass123
MSSQL_DATABASE=TIAdminDb
MSSQL_USER=sa

# --- JWT (SOLO DESARROLLO - generar valores aleatorios en prod) ---
JWT_ISSUER=https://tiadmin.local
JWT_AUDIENCE=tiadmin-api
JWT_SECRET=CHANGE_ME_DEVELOPMENT_ONLY_DO_NOT_USE_IN_PRODUCTION_0123456789

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Redis (opcional) ---
REDIS_CONNECTION=localhost:6379

# --- Email (dev: se escribe a consola/log) ---
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@tiadmin.local
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
